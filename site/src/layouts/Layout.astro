---
// Every page: the head, the top bar with the mark and the way in, the content and the foot.
import "../styles/global.css";
import { HUB_URL, SITE_NAME, link } from "../lib/site";
import Mark from "../components/Mark.astro";

interface Props {
	title: string;
	description: string;
	page?: "home" | "board" | "rules" | "me" | "bot";
	noindex?: boolean;
}
const { title, description, page = "home", noindex = false } = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : null;
// The picture a shared link shows (brand/share.mjs draws it): an absolute address, when the site has one.
const picture = Astro.site ? new URL(link("/share.png"), Astro.site).href : null;
const nav = [
	{ key: "board", href: link("/board/"), label: "Board" },
	{ key: "how", href: `${link("/")}#how`, label: "How it works" },
	{ key: "rules", href: link("/rules/"), label: "Rules" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
		<link rel="icon" href={link("/favicon.ico")} sizes="48x48" />
		<link rel="apple-touch-icon" href={link("/apple-touch-icon.png")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0b0c0d" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={`${SITE_NAME}, by The Market Hub`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{picture && <meta property="og:image" content={picture} />}
		{picture && <meta property="og:image:width" content="1200" />}
		{picture && <meta property="og:image:height" content="630" />}
		{picture && <meta property="og:image:alt" content="Bot League, by The Market Hub" />}
		<meta name="twitter:card" content={picture ? "summary_large_image" : "summary"} />
		<title>{title}</title>
		<script is:inline>
			// Visits are counted by Cloudflare Web Analytics, which sets no cookie, as on the rest of
			// Market Hub. On the public domain only: a local preview counts nothing.
			if (/(^|\.)themarkethub\.app$/.test(location.hostname)) {
				const beacon = document.createElement("script");
				beacon.type = "module";
				beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
				beacon.dataset.cfBeacon = JSON.stringify({ token: "592b6306f5104483a0a6877de93785b5" });
				document.head.append(beacon);
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="flex min-h-screen flex-col bg-page text-ink antialiased">
		<header class="topbar">
			<div class="wrap flex h-14 items-center gap-4 lg:gap-8">
				<div class="flex flex-none items-baseline gap-2.5 whitespace-nowrap">
					<a href={link("/")} class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight text-ink-strong" aria-label="Bot League, home">
						<Mark class="h-5 w-5 self-center" />
						<span>Bot League</span>
					</a>
					<a href={HUB_URL} class="hidden text-[12.5px] text-muted hover:text-ink-strong sm:inline">by The Market Hub</a>
				</div>
				<nav class="hidden sm:block" aria-label="Main">
					<ul class="flex items-center gap-5">
						{nav.map((n) => <li><a class="nav-link" href={n.href} aria-current={n.key === page ? "page" : undefined}>{n.label}</a></li>)}
					</ul>
				</nav>
				<div class="ml-auto flex items-center gap-3" id="account">
					<a class="btn btn-primary py-1.5 text-[13px]" href={link("/me/")} data-me>Your bot</a>
				</div>
			</div>
			<nav class="border-t border-line sm:hidden" aria-label="Main">
				<ul class="flex gap-5 overflow-x-auto px-5 text-sm [scrollbar-width:none]">
					{nav.map((n) => <li><a class="nav-link -mb-px block py-2" href={n.href} aria-current={n.key === page ? "page" : undefined}>{n.label}</a></li>)}
					<li><a class="nav-link -mb-px block py-2" href={HUB_URL}>The Market Hub</a></li>
				</ul>
			</nav>
		</header>
		<main class="flex-1 pb-24">
			<slot />
		</main>
		<footer class="border-t border-line">
			<div class="wrap grid gap-6 py-8 text-[13px] text-muted md:grid-cols-[1fr_auto]">
				<div class="max-w-2xl space-y-2">
					<p>
						Bot League is part of <a href={HUB_URL} class="link">The Market Hub</a>. Bots of rules, built with an AI agent and run on
						paper: no money, no broker, no orders.
					</p>
					<p>Nothing here is investment advice or a recommendation to buy or sell anything. Past returns say nothing about future ones.</p>
				</div>
				<div class="flex flex-wrap items-start gap-x-5 gap-y-1">
					<a href={link("/board/")} class="hover:text-ink-strong">Board</a>
					<a href={link("/rules/")} class="hover:text-ink-strong">Rules</a>
					<a href={`${HUB_URL}/privacy/`} class="hover:text-ink-strong">Privacy</a>
					<a href={`${HUB_URL}/terms/`} class="hover:text-ink-strong">Terms</a>
					<a href={HUB_URL} class="hover:text-ink-strong">The Market Hub</a>
				</div>
			</div>
		</footer>
		<script>
			// The way in says who is in: "Your bot" for a member, "Sign in" for a visitor.
			import { api, link, localVisitor } from "../lib/site";
			import type { Me } from "../lib/types";
			localVisitor();
			api<Me>("/api/me")
				.then((me) => {
					const a = document.querySelector<HTMLAnchorElement>("[data-me]");
					if (!a) return;
					if (me.user) {
						a.textContent = "Your bot";
						a.href = link("/me/");
					} else {
						a.textContent = "Sign in";
						a.href = me.signin ?? link("/me/");
					}
					(window as unknown as { __me?: Me }).__me = me;
					document.dispatchEvent(new CustomEvent("me", { detail: me }));
				})
				.catch(() => {});
		</script>
	</body>
</html>
