---
// A bot's own page (/bot/?b=slug): its idea, its returns and ranks, its curve against the S&P 500
// from its first close, and what it holds. A house bot's rules are public, as are the kit's; a
// member's are shown to its owner alone.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="A bot · Bot League" description="A bot of Bot League: its idea, its returns against the S&P 500 and what it holds." page="bot" noindex>
	<section class="wrap pt-10" id="bot">
		<div class="skeleton h-6 w-40"></div><div class="skeleton mt-4 h-12 w-96 max-w-full"></div><div class="skeleton mt-8 h-72"></div>
	</section>
</Layout>

<script>
	import { lineChart } from "../../lib/chart";
	import { add, h } from "../../lib/dom";
	import { day, ordinal, plural, signedPct, tone } from "../../lib/format";
	import { ApiError, api, link, localVisitor } from "../../lib/site";
	import { PERIODS, digits, type BotPage } from "../../lib/types";
	import { bars, moves, strip, versions } from "../../lib/doings";

	localVisitor();
	const root = document.getElementById("bot")!;
	const slug = new URLSearchParams(location.search).get("b") ?? "";

	function stats(b: BotPage): HTMLElement {
		return add(h("div", "mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-5"),
			...PERIODS.map((p) => {
				const v = b.returns[p.key];
				const rank = b.ranks[p.key];
				return add(h("div", "bg-page p-4"), h("div", "label", p.label),
					h("div", `num mt-1 text-[22px] font-semibold ${tone(v)}`, v == null ? "—" : signedPct(v, digits(p.key))),
					h("div", "mt-0.5 text-[12px] text-muted", b.house ? (v == null ? "not yet" : "house · not ranked") : rank ? `${ordinal(rank)} of ${b.entrants}` : v == null ? "not yet" : " "));
			}));
	}

	const section = (title: string, note: string | null, ...body: (Node | null)[]) =>
		add(h("section", "sec mt-12"), add(h("div", "sec-head"), h("h2", "sec-title", title), note ? h("span", "sec-note", note) : null), ...body);

	function holdings(b: BotPage): HTMLElement | null {
		if (!b.since) return null;
		const weights = Object.fromEntries(b.holdings.map((x) => [x.ticker, x.weight]));
		return section("What it holds now", b.paused ? `Paused: in cash · after the close of ${day(b.as_of)}` : `${plural(b.holding, "stock")} · after the close of ${day(b.as_of)}`,
			bars(weights, b.cash));
	}

	// Before its first close: when it starts, and what its rules would hold at the last close.
	function preview(b: BotPage): HTMLElement | null {
		if (b.since || !b.preview) return null;
		return section("What its rules would hold", `A preview, at the close of ${day(b.preview.as_of)}: its record starts at the close of ${day(b.starts)}`,
			bars(b.preview.weights));
	}

	function doings(b: BotPage): HTMLElement[] {
		if (!b.since) return [];
		const over = strip(b.log);
		return [
			section("What it did", "Each rebalance, the latest first: bought (+), sold (−), raised (↑) and cut (↓)", moves(b.log)),
			over ? section("What it held over time", "After each rebalance; darker is more", over) : null,
			b.house ? null : section("Changes", "When its owner changed its rules or pressed a switch. The rules themselves stay theirs.", versions(b.versions)),
		].filter((x): x is HTMLElement => !!x);
	}

	function rules(b: BotPage): HTMLElement | null {
		if (!b.rules) return null;
		const sec = add(h("section", "sec mt-12"), add(h("div", "sec-head"), h("h2", "sec-title", "Its rules"),
			h("span", "sec-note", b.house ? "A house bot: the kit's example, open to all" : "Only you see them")));
		add(sec, add(h("ul", "max-w-3xl space-y-2 text-[14px] text-ink"), ...b.rules.map((r) => add(h("li", "flex gap-2"), h("span", "text-signal", "›"), h("span", "", r)))));
		if (b.bot) {
			const d = add(h("details", "mt-5 max-w-3xl"), h("summary", "cursor-pointer text-[13px] text-muted hover:text-ink-strong", "The file"),
				h("pre", "code frame mt-2 p-4", JSON.stringify(b.bot, null, 2)));
			sec.append(d);
		}
		return sec;
	}

	function draw(b: BotPage) {
		document.title = `${b.name} · Bot League`;
		const chart = h("div", "mt-4");
		const started = b.since
			? `Running since the close of ${day(b.since)} · ${plural(b.sessions, "session")}${b.paused ? " · paused, in cash" : ""}`
			: `Sent in: its record starts at the close of ${day(b.starts)}, the first close after it was sent in. Nothing before counts.`;
		root.replaceChildren();
		add(root,
			add(h("a", "text-[13px] text-muted hover:text-ink-strong"), "← The board"),
			add(h("div", "mt-4 flex flex-wrap items-center gap-2"), b.house ? h("span", "tag", "house bot") : null, b.you ? h("span", "tag tag-you", "your bot") : null),
			h("h1", "h2 mt-2", b.name),
			h("p", "mt-1 text-[14px] text-muted", b.house ? "By Bot League, from the kit's examples" : `By ${b.handle}`),
			b.about ? h("p", "mt-4 max-w-2xl text-[16px] text-ink", b.about) : null,
			h("p", "mt-3 text-[13px] text-muted", started),
			stats(b),
			b.curve.length ? add(h("section", "sec mt-12"),
				add(h("div", "sec-head"), h("h2", "sec-title", "Against the S&P 500"), add(h("span", "sec-note flex items-center gap-4"),
					add(h("span", "flex items-center gap-1.5"), Object.assign(h("i", "inline-block h-[3px] w-4 rounded bg-signal"), {}), b.name),
					add(h("span", "flex items-center gap-1.5"), h("i", "inline-block h-[3px] w-4 rounded bg-muted"), "S&P 500"))),
				chart) : null,
			holdings(b),
			preview(b),
			...doings(b),
			rules(b),
		);
		(root.firstElementChild as HTMLAnchorElement).href = link("/board/");
		if (b.curve.length) {
			lineChart(chart, b.curve.map((p) => p.date), [
				{ name: "S&P 500", values: b.curve.map((p) => p.index), color: "var(--color-muted)", width: 1.5 },
				{ name: b.name, values: b.curve.map((p) => p.bot), color: "var(--color-signal)", width: 2.25 },
			]);
		}
	}

	api<BotPage>(`/api/board/bot/${encodeURIComponent(slug)}`)
		.then(draw)
		.catch((e) => {
			const signin = e instanceof ApiError ? e.signin : null;
			const msg = !slug ? "No bot was asked for." : e instanceof Error ? e.message : "This bot could not be read.";
			const back = h("a", "btn btn-ghost mt-6", "The board");
			back.href = link("/board/");
			const actions = add(h("div", "flex flex-wrap gap-3"), signin ? Object.assign(h("a", "btn btn-signal mt-6", "Sign in"), { href: signin }) : null, back);
			root.replaceChildren(add(h("div", "py-16 text-center"), h("p", "text-[16px] text-ink", msg), add(h("div", "flex justify-center"), actions)));
		});
</script>
