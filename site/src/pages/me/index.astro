---
// The member's own page. With no bot yet: how to create one, nothing else. With a bot: the bot
// drawn, at a glance (what it holds, how it is doing, what it has done), the tools to change it
// behind one button, and building again from scratch in a small corner at the foot.
// Signed in with the Market Hub account.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Your bot · Bot League" description="Your bot in Bot League, the kit to build it with your AI agent, and your key." page="me" noindex>
	<section class="wrap pt-10" id="me">
		<div class="flex items-center gap-5"><div class="skeleton h-24 w-24"></div><div class="flex-1"><div class="skeleton h-9 w-72 max-w-full"></div><div class="skeleton mt-3 h-5 w-48"></div></div></div>
		<div class="skeleton mt-10 h-72"></div>
	</section>
</Layout>

<script>
	import { chartWaiting, lineChart, type Series } from "../../lib/chart";
	import { add, h } from "../../lib/dom";
	import { day, plural, signedPct, timeAgo, tone } from "../../lib/format";
	import { detail, rankMeter, timeline, treemap } from "../../lib/mybot";
	import { robot, robotSvg } from "../../lib/robot";
	import { API, ApiError, api, botUrl, localVisitor } from "../../lib/site";
	import { PERIODS, digits, type Bot, type BotPage, type ChatAnswer, type Key, type Me, type MyBot, type Overview, type Spec } from "../../lib/types";
	import { said, strip } from "../../lib/doings";
	import { asBot, editor } from "../../lib/editor";

	localVisitor();
	const root = document.getElementById("me")!;
	let data: Overview;
	let page: BotPage | null = null; // the bot's public page, read for its curve against the index and its start
	let shownKey: string | null = null; // a key just made: shown once, until the page is left

	const button = (cls: string, text: string, onClick: (b: HTMLButtonElement) => void) => {
		const b = h("button", cls, text);
		b.type = "button";
		b.addEventListener("click", () => onClick(b));
		return b;
	};
	const anchor = (cls: string, text: string, href: string) => Object.assign(h("a", cls, text), { href });
	const slugOf = (handle: string) => handle.replace(/[\s_-]+/g, "").toLowerCase();
	const section = (title: string, note?: Node | string | null) =>
		add(h("section", "sec mt-10"), add(h("div", "sec-head"), h("h2", "sec-title", title), note ? add(h("span", "sec-note"), note) : null));

	// --- Signed out ---

	function signedOut(signin: string | null) {
		root.replaceChildren(add(h("div", "frame relative mx-auto mt-6 max-w-xl overflow-hidden px-6 py-12 text-center sm:px-10"),
			h("p", "kicker relative", "Your bot"),
			h("h1", "h2 relative mt-3", "Sign in with your account on The Market Hub"),
			h("p", "relative mx-auto mt-4 max-w-md text-[15px] text-muted", "The same account as on The Market Hub, with Google or your email. Then download the kit, with your key in it, and build your bot with your agent."),
			signin ? anchor("btn btn-signal btn-big relative mt-8", "Sign in to The Market Hub", signin) : h("p", "relative mt-6 text-[13px] text-muted", "Sign-in is not set up on this copy of the site.")));
	}

	// --- The kit and the key ---

	async function downloadKit(): Promise<void> {
		const res = await fetch(`${API}/api/bots/kit`, { method: "POST", credentials: "include" });
		if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail ?? `Request failed (${res.status}).`);
		const url = URL.createObjectURL(await res.blob());
		const a = Object.assign(document.createElement("a"), { href: url, download: "markethub-bot.zip" });
		document.body.append(a);
		a.click();
		a.remove();
		setTimeout(() => URL.revokeObjectURL(url), 10_000);
	}

	function kitButton(cls: string, status: HTMLElement, after: () => void): HTMLButtonElement {
		return button(cls, "Download the kit", async (el) => {
			el.disabled = true;
			status.textContent = "Making your key and the kit…";
			try {
				await downloadKit();
				status.textContent = "Downloaded, with a new key in its .env. Any key you had before no longer works.";
				data = await api<Overview>("/api/bots");
				after();
			} catch (e) {
				status.textContent = e instanceof Error ? e.message : "The kit could not be made.";
			}
			el.disabled = false;
		});
	}

	function keys(o: Overview): HTMLElement {
		const box = h("div");
		const k: Key | null = o.key;
		const make = button("btn btn-ghost py-1.5 text-[13px]", k ? "New key" : "Make a key", async (el) => {
			el.disabled = true;
			shownKey = (await api<{ key: string }>("/api/bots/key", { method: "POST" })).key;
			data = await api<Overview>("/api/bots");
			box.replaceWith(keys(data));
		});
		const drop = k ? button("btn btn-ghost py-1.5 text-[13px]", "Take it back", async (el) => {
			if (!confirm("Take your key back? Your agent can no longer send in or follow your bot until you make a new one.")) return;
			el.disabled = true;
			shownKey = null;
			await api("/api/bots/key", { method: "DELETE" });
			data = await api<Overview>("/api/bots");
			box.replaceWith(keys(data));
		}) : null;
		add(box, h("p", "text-[12.5px] text-muted", k
			? `Your key: made ${timeAgo(k.created_utc)}, ${k.used_utc ? `last used ${timeAgo(k.used_utc)}` : "not used yet"}. It lets your agent check, backtest and send in your bot, nothing else. Keep it to yourself.`
			: "No key yet. Downloading the kit makes one, or make it here for a kit you already have."));
		if (shownKey && k) {
			const code = h("code", "num block min-w-0 flex-1 truncate rounded-[3px] border border-line bg-page px-2 py-1.5 text-[12.5px] text-ink-strong", shownKey);
			const copy = button("btn btn-ghost py-1.5 text-[13px]", "Copy", (el) => navigator.clipboard.writeText(shownKey!).then(() => (el.textContent = "Copied")));
			add(box, add(h("div", "mt-2 flex items-center gap-2"), code, copy), h("p", "mt-1 text-[12px] text-warn", "Shown this once. Paste it in the kit's .env as MARKETHUB_BOT_KEY=…"));
		}
		return add(box, add(h("p", "mt-2 flex flex-wrap gap-2"), make, drop));
	}

	// --- No bot yet: create one ---

	function create(me: Me) {
		const status = h("p", "mt-2 min-h-[1.2em] text-[12.5px] text-muted");
		let keyBox = keys(data);
		const step = (n: number, title: string, ...body: (Node | null)[]) => add(h("li", "frame flex flex-col p-5"),
			h("span", "step-n", String(n)), h("h3", "mt-4 text-[16px] font-semibold text-ink-strong", title), ...body);
		const blueprint = h("span", "robot opacity-40");
		blueprint.innerHTML = robotSvg(slugOf(me.user?.name ?? "you"), 104);
		root.replaceChildren(
			add(h("div", "flex items-center gap-5"), blueprint, add(h("div", "min-w-0"),
				h("p", "kicker", me.user?.name ? `Hello, ${me.user.name.split(" ")[0]}` : "Your bot"),
				h("h1", "h2 mt-1", "Create your bot"),
				h("p", "mt-2 max-w-xl text-[14px] text-muted", "A few rules, written with your AI agent. It runs on paper and is ranked from the next close."))),
			add(h("ol", "mt-10 grid gap-4 md:grid-cols-3"),
				step(1, "Get the kit", h("p", "text-[13.5px] text-muted", "Your key is inside."), add(h("div", "mt-auto pt-4"), kitButton("btn btn-signal", status, () => keyBox.replaceWith((keyBox = keys(data)))), status)),
				step(2, "Open it with your agent", h("p", "text-[13.5px] text-muted", "Unzip it and start Claude Code, Codex or yours inside."),
					h("p", "term mt-auto rounded-[3px] border border-line bg-page px-3 py-2 pt-2", "$ cd markethub-bot && claude")),
				step(3, "Say “Let's build my bot”", h("p", "text-[13.5px] text-muted", "It writes the rules with you, backtests them and sends the bot in."),
					h("p", "term mt-auto rounded-[3px] border border-line bg-page px-3 py-2 text-ink-strong", "› Let's build my bot"))),
			add(h("details", "corner mt-8"), h("summary", "", "Already have the kit? Your key ›"), add(h("div", "mt-3 max-w-xl"), keyBox)));
	}

	// --- A bot: drawn ---

	function statusOf(you: MyBot): HTMLElement {
		if (!you.since) return h("span", "status is-waiting", `Starts at the close of ${page?.starts ? day(page.starts) : "the next session"}`);
		if (you.paused) return h("span", "status is-paused", "Paused · in cash");
		return h("span", "status", `Running · ${plural(you.sessions, "session")} since ${day(you.since)}`);
	}

	// Renaming it: at once, keeping its record, and not the day's change of rules.
	let renaming = false;

	function title(you: MyBot): HTMLElement {
		if (!renaming) {
			return add(h("div"),
				add(h("div", "mt-1 flex flex-wrap items-baseline gap-x-3"), h("h1", "h2", you.name),
					button("text-[13px] text-muted hover:text-ink-strong", "Rename", () => {
						renaming = true;
						draw(lastMe!);
					})),
				you.about ? h("p", "mt-1 max-w-2xl text-[14px] text-muted", you.about) : null);
		}
		const name = h("input", "field max-w-md");
		name.value = you.name;
		name.maxLength = 40;
		const about = h("textarea", "field mt-2 min-h-[56px] max-w-2xl");
		about.value = you.about;
		about.maxLength = 280;
		const note = h("p", "mt-1 text-[12.5px] text-muted", "The new name shows at once and the record goes on. Its page says it was renamed.");
		const save = button("btn btn-primary py-1.5 text-[13px]", "Save", async (el) => {
			el.disabled = true;
			try {
				await api("/api/bots/mine/name", { method: "PUT", body: { name: name.value, about: about.value } });
				renaming = false;
				await reload();
			} catch (e) {
				note.textContent = e instanceof Error ? e.message : "That did not work.";
				note.className = "mt-1 text-[12.5px] text-warn";
				el.disabled = false;
			}
		});
		const cancel = button("btn btn-ghost py-1.5 text-[13px]", "Cancel", () => {
			renaming = false;
			draw(lastMe!);
		});
		return add(h("div", "mt-1 w-full"), add(h("label", "block"), h("span", "label block pb-1", "Name"), name),
			add(h("label", "block"), h("span", "label mt-2 block pb-1", "Idea"), about), note, add(h("div", "mt-2 flex gap-2"), save, cancel));
	}

	function head(you: MyBot): HTMLElement {
		const slug = you.id ?? "";
		const pending = you.pending ? button("status is-waiting hover:border-muted", `Next close: ${said(you.pending.what) || "a change"}`, () => toggleChange(true)) : null;
		return add(h("div", "flex flex-wrap items-center gap-x-6 gap-y-4"),
			robot(slug, 104, "robot-big"),
			add(h("div", "min-w-0 flex-1"),
				h("p", "kicker", `Your bot · by ${you.handle}, the first name of your account`),
				title(you),
				add(h("div", "mt-3 flex flex-wrap items-center gap-2"), statusOf(you), pending)),
			add(h("div", "flex w-full flex-wrap items-center gap-3 sm:w-auto"),
				button("btn btn-signal", changeOpen ? "Close" : "Change it", () => toggleChange(!changeOpen)),
				anchor("text-[13px] text-muted hover:text-ink-strong", "Its public page →", botUrl(slug))));
	}

	function numbers(you: MyBot): HTMLElement {
		return add(h("div", "mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-5"),
			...PERIODS.map((p) => {
				const v = you.returns?.[p.key] ?? null;
				return add(h("div", `min-w-0 bg-page p-4 ${p.key === "all" ? "col-span-2 sm:col-span-1" : ""}`), h("div", "label", p.label),
					h("div", `num mt-1 text-[22px] font-semibold ${tone(v)}`, v == null ? "—" : signedPct(v, digits(p.key))),
					v == null ? h("div", "mt-2 text-[12px] text-faint", "not yet") : rankMeter(you.ranks[p.key], you.entrants));
			}));
	}

	function curve(you: MyBot): HTMLElement {
		const chart = h("div");
		const sec = add(section("How it's doing", page?.curve.length ? "against the S&P 500" : null), chart);
		requestAnimationFrame(() => {
			if (page && page.curve.length) {
				const series: Series[] = [
					{ name: "S&P 500", values: page.curve.map((p) => p.index), color: "var(--color-muted)", width: 1.5 },
					{ name: you.name, values: page.curve.map((p) => p.bot), color: "var(--color-signal)", width: 2.25 },
				];
				lineChart(chart, page.curve.map((p) => p.date), series, 260);
			} else if (you.curve.length > 1) {
				lineChart(chart, you.curve.map((p) => p.date), [{ name: you.name, values: you.curve.map((p) => p.value), color: "var(--color-signal)" }], 260);
			} else chartWaiting(chart, you.since ? "Its line shows from its second close." : `Its line starts at the close of ${page?.starts ? day(page.starts) : "the next session"}.`, 160);
		});
		return sec;
	}

	function holds(you: MyBot): HTMLElement {
		if (!you.since && you.preview) {
			return add(section("What it would hold", add(h("span", "flex items-center gap-2"), h("span", "tag", "preview"), `at the close of ${day(you.preview.as_of)}`)),
				treemap(you.preview.weights, null, { preview: true }));
		}
		const weights = Object.fromEntries(you.holdings.map((x) => [x.ticker, x.weight]));
		return add(section("What it holds", you.as_of ? `after the close of ${day(you.as_of)}` : null), treemap(weights, you.cash));
	}

	function held(you: MyBot): HTMLElement | null {
		const grid = strip(you.log, 30, 10);
		return grid ? add(section("What it has held", "darker for more"), grid) : null;
	}

	function done(you: MyBot): HTMLElement | null {
		if (!you.since) return null;
		const versions = you.versions.map(({ from, what }) => ({ from, what }));
		const read = h("div", "mt-3 min-h-[2rem] border-t border-line pt-3");
		const first = you.log[0] ?? versions[versions.length - 1];
		if (first) read.append(detail(first, said));
		else read.append(h("p", "text-[13px] text-muted", "No rebalance yet."));
		const out = add(section("What it has done", you.log.length ? plural(you.log.length, "rebalance") : null),
			timeline(you.log, versions, you.since, you.as_of ?? you.since, (item) => read.replaceChildren(detail(item, said))), read);
		if (you.exclude.length) out.append(add(h("div", "mt-4 flex flex-wrap items-center gap-1.5"), h("span", "mr-1 text-[12.5px] text-muted", "Left out"),
			...you.exclude.map((t) => h("span", "chip num", t))));
		return out;
	}

	function rules(you: MyBot): HTMLElement {
		return add(h("details", "corner mt-10"), h("summary", "", "Its rules, in words · only you see them ›"),
			add(h("ul", "mt-3 max-w-3xl space-y-1.5 text-[13.5px] text-ink"), ...you.rules.map((r) => add(h("li", "flex gap-2"), h("span", "text-muted", "›"), h("span", "", r)))));
	}

	// Building again from scratch: the kit, the key and withdrawing, folded away.
	function corner(o: Overview): HTMLElement {
		const status = h("p", "mt-1 text-[12.5px] text-muted");
		let keyBox = keys(o);
		return add(h("details", "corner mt-4 border-t border-line pt-4"), h("summary", "", "Start again from scratch · the kit and your key ›"),
			add(h("div", "mt-4 grid max-w-3xl gap-5 sm:grid-cols-2"),
				add(h("div"), h("p", "text-[12.5px] text-muted", "A new bot sent in with your agent replaces this one and its record starts again."),
					add(h("div", "mt-2"), kitButton("btn btn-ghost py-1.5 text-[13px]", status, () => keyBox.replaceWith((keyBox = keys(data))))), status,
					add(h("p", "mt-3"), button("btn btn-ghost py-1.5 text-[13px]", "Withdraw this bot", async (el) => {
						if (!confirm("Withdraw your bot? Its record goes with it, and a new one starts from zero.")) return;
						el.disabled = true;
						await api("/api/bots/mine", { method: "DELETE" });
						await reload();
					}))),
				keyBox));
	}

	// --- Changing it: editor, chat and switches, behind "Change it" -------------------------------

	let spec: Spec | null = null;
	let chatOn = false;
	let changeOpen = false;
	let tab: "editor" | "chat" | "switches" = "editor";
	const history: { role: "user" | "assistant"; text: string }[] = []; // this visit only: nothing of the chat is kept
	let startBot: Bot | null = null;
	let changeBox: HTMLElement | null = null;

	function toggleChange(open: boolean) {
		changeOpen = open;
		if (lastMe) draw(lastMe);
		if (open) changeBox?.scrollIntoView({ behavior: "smooth", block: "start" });
	}

	function waiting(you: MyBot): HTMLElement | null {
		const p = you.pending;
		if (!p) return null;
		return add(h("div", "frame mb-5 p-4"), h("p", "label", "Waiting for the next close"),
			h("p", "mt-1 text-[14px] text-ink-strong", said(p.what) || "No change"),
			h("p", "mt-1 text-[12.5px] text-muted", `Asked ${timeAgo(p.changed_utc)}. It applies at the next close and the bot rebalances on it there; its record goes on.`));
	}

	function switches(you: MyBot): HTMLElement {
		const state = you.pending ?? { paused: you.paused, exclude: you.exclude };
		const note = h("p", "mt-2 text-[12.5px] text-warn");
		const press = async (action: string, ticker?: string) => {
			try {
				await api("/api/bots/mine/switch", { method: "POST", body: { action, ticker } });
				await reload();
			} catch (e) {
				note.textContent = e instanceof Error ? e.message : "That did not work.";
			}
		};
		const ticker = h("input", "field num w-32 uppercase");
		ticker.placeholder = "NVDA";
		const leave = button("btn btn-ghost py-1.5 text-[13px]", "Leave it out", () => {
			if (ticker.value.trim()) press("exclude", ticker.value.trim());
		});
		return add(h("div", "space-y-6"),
			add(h("div"), h("p", "text-[14px] font-semibold text-ink-strong", state.paused ? "Paused" : "Running"),
				h("p", "mt-1 text-[13px] text-muted", state.paused
					? "From the next close it holds cash until you resume it. Its record goes on."
					: "Pausing it sells everything at the next close and holds cash until you resume it."),
				add(h("p", "mt-2"), button(`btn ${state.paused ? "btn-primary" : "btn-ghost"} py-1.5 text-[13px]`, state.paused ? "Resume" : "Pause", () => press(state.paused ? "resume" : "pause")))),
			add(h("div"), h("p", "text-[14px] font-semibold text-ink-strong", "Companies left out"),
				h("p", "mt-1 text-[13px] text-muted", "A company left out is sold at the next close and never chosen again, until you let it back in."),
				add(h("div", "mt-2 flex flex-wrap gap-2"), ticker, leave),
				state.exclude.length ? add(h("div", "mt-3 flex flex-wrap gap-1.5"), ...state.exclude.map((t) =>
					add(h("span", "chip"), t, button("ml-1 text-muted hover:text-ink-strong", "×", () => press("include", t))))) : null,
				note),
			h("p", "text-[12.5px] text-muted", "Switches are not a change of rules: they do not count as the day's change. There are no orders: the bot only follows its rules."));
	}

	function chat(you: MyBot): HTMLElement {
		if (!chatOn) return h("p", "text-[13.5px] text-muted", "The chat is not switched on yet. The editor does the same, by hand.");
		const log = h("div", "space-y-3");
		const input = h("textarea", "field min-h-[64px]");
		input.placeholder = "Drop the tech stocks · make it more defensive · hold fewer stocks";
		input.maxLength = 600;
		const status = h("p", "text-[12.5px] text-muted");
		const bubble = (role: "user" | "assistant", text: string) =>
			h("p", `max-w-[46rem] rounded-[4px] px-3 py-2 text-[13.5px] ${role === "user" ? "ml-auto bg-raised text-ink-strong" : "border border-line text-ink"}`, text);
		for (const t of history) log.append(bubble(t.role, t.text));
		const proposalCard = (proposal: Bot, rules: string[]) => add(h("div", "frame p-4"), h("p", "label pb-2", "Proposed: the bot, in words"),
			add(h("ul", "space-y-1.5 text-[13.5px] text-ink"), ...rules.map((r) => add(h("li", "flex gap-2"), h("span", "text-muted", "›"), h("span", "", r)))),
			add(h("div", "mt-3 flex flex-wrap gap-2"),
				button("btn btn-primary py-1.5 text-[13px]", "Apply from the next close", async (b) => {
					if (!confirm("Apply these rules from the next close? The bot keeps its record, and its page will say that its rules changed. Once a day.")) return;
					b.disabled = true;
					try {
						await api("/api/bots/mine/rules", { method: "PUT", body: { bot: proposal } });
						await reload();
					} catch (e) {
						status.textContent = e instanceof Error ? e.message : "That did not work.";
						b.disabled = false;
					}
				}),
				button("btn btn-ghost py-1.5 text-[13px]", "Open in the editor", () => {
					startBot = asBot(proposal);
					tab = "editor";
					drawChange(you);
				})));
		const send = button("btn btn-primary", "Send", async (el) => {
			const message = input.value.trim();
			if (!message) return;
			el.disabled = true;
			status.textContent = "Thinking…";
			log.append(bubble("user", message));
			try {
				const got = await api<ChatAnswer>("/api/bots/mine/chat", { method: "POST", body: { message, history } });
				history.push({ role: "user", text: message }, { role: "assistant", text: got.reply });
				log.append(bubble("assistant", got.reply));
				if (got.problems?.length) log.append(h("p", "text-[12.5px] text-warn", `The proposal did not pass the checks: ${got.problems.join(" ")}`));
				if (got.proposal) log.append(proposalCard(got.proposal, got.rules ?? []));
				input.value = "";
				status.textContent = "";
			} catch (e) {
				status.textContent = e instanceof Error ? e.message : "The chat could not answer.";
			}
			el.disabled = false;
		});
		return add(h("div", "space-y-3"), h("p", "text-[13px] text-muted", "Say what to change in your words. Claude proposes the new rules; nothing changes until you apply them."),
			log, input, add(h("div", "flex items-center gap-3"), send, status));
	}

	function drawChange(you: MyBot) {
		if (!changeBox || !spec) return;
		const tabs = h("div", "tabs");
		for (const [k, label] of [["editor", "Rules"], ["chat", "Ask Claude"], ["switches", "Pause or leave out"]] as const) {
			const t = h("button", "tab-btn", label);
			t.type = "button";
			t.setAttribute("aria-selected", String(tab === k));
			t.addEventListener("click", () => {
				tab = k;
				drawChange(you);
			});
			tabs.append(t);
		}
		const body = tab === "editor" ? editor(spec, startBot ?? you.pending?.bot ?? you.bot, () => reload()) : tab === "chat" ? chat(you) : switches(you);
		changeBox.replaceChildren();
		add(changeBox,
			add(h("div", "sec-head"), h("h2", "sec-title", "Change it"), add(h("span", "sec-note flex flex-wrap items-center gap-3"),
				you.rules_changed_utc ? `Rules last changed ${timeAgo(you.rules_changed_utc)} · once a day, from the next close` : "Once a day, from the next close · its record goes on",
				button("btn btn-ghost py-1 text-[13px]", "Done", () => toggleChange(false)))),
			waiting(you), tabs, add(h("div", "mt-5"), body));
	}

	function change(you: MyBot): HTMLElement | null {
		if (!changeOpen) return (changeBox = null);
		changeBox = h("section", "frame mt-8 scroll-mt-20 p-5 sm:p-6");
		drawChange(you);
		return changeBox;
	}

	// --- The page ---

	let lastMe: Me | null = null;

	async function readPage(you: MyBot | null) {
		page = you?.id ? await api<BotPage>(`/api/board/bot/${encodeURIComponent(you.id)}`).catch(() => null) : null;
	}

	async function reload() {
		data = await api<Overview>("/api/bots");
		await readPage(data.you);
		startBot = null;
		if (!data.you) changeOpen = false;
		if (lastMe) draw(lastMe);
	}

	function draw(me: Me) {
		lastMe = me;
		const you = data.you;
		if (!you) return create(me);
		root.replaceChildren();
		const pair = you.since ? [curve(you), add(h("div", "grid gap-x-10 lg:grid-cols-2"), holds(you), held(you) ?? h("div"))]
			: [add(h("div", "grid gap-x-10 lg:grid-cols-2"), holds(you), curve(you))]; // before it starts: what it would hold first
		add(root, head(you), change(you), you.since ? numbers(you) : null, ...pair, done(you), rules(you), corner(data));
	}

	async function load() {
		const me = await api<Me>("/api/me");
		if (!me.user) return signedOut(me.signin);
		try {
			data = await api<Overview>("/api/bots");
		} catch (e) {
			if (e instanceof ApiError && e.status === 401) return signedOut(e.signin ?? me.signin);
			throw e;
		}
		[spec, chatOn] = await Promise.all([api<Spec>("/api/bot/spec"), api<{ on: boolean }>("/api/bots/chat").then((c) => c.on).catch(() => false), readPage(data.you)]);
		draw(me);
		if (data.stale) {
			await api("/api/bots/refresh", { method: "POST" }).catch(() => null);
			await reload();
		}
	}
	load().catch((e) => root.replaceChildren(h("p", "py-16 text-center text-[15px] text-muted", e instanceof Error ? e.message : "Your page could not be read.")));
</script>
