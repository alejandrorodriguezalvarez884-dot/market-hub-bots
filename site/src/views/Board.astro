---
// The whole leaderboard: every bot over the day, week, month, year or since it started, ranked
// among those that have run that long, with the index as the line of reference, and the reader's
// own place when they play.
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
import type { Lang } from "../i18n";
import { board as words } from "../i18n/board";
import { weekly as weeklyWords } from "../i18n/weekly";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = words[lang];
const tw = weeklyWords[lang];
---

<Layout title={t.title} description={t.description} page="board" lang={lang}>
	<section class="wrap pt-10">
		<p class="kicker">{t.kicker}</p>
		<div class="mt-3 flex flex-wrap items-end justify-between gap-4">
			<h1 class="h2">{t.h1}</h1>
			<span class="live" id="asof">{t.loading}</span>
		</div>
		<p class="mt-3 max-w-2xl text-[14px] text-muted" id="lede">
			{t.lede}
		</p>
		<a href="#weekly" class="mt-3 inline-flex items-center gap-1.5 text-[13px] text-muted hover:text-ink-strong" id="to-weekly" hidden>{tw.jump} ↓</a>
		<Welcome lang={lang} class="mt-6" />
		<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-b border-line pb-3">
			<div id="tabs"></div>
			<span class="text-[12.5px] text-muted" id="count"></span>
		</div>
		<div id="board" class="mt-2"><div class="space-y-2 pt-3"><div class="skeleton h-10"></div><div class="skeleton h-10"></div><div class="skeleton h-10"></div><div class="skeleton h-10"></div></div></div>
		<div id="weekly"></div>
	</section>
</Layout>

<script>
	import { locked, ordered, periodTabs, type Entry } from "../lib/board";
	import { sparkline } from "../lib/chart";
	import { indexFace, robot } from "../lib/robot";
	import { trophy, weeklySection, winsTag } from "../lib/weekly";
	import { add, h } from "../lib/dom";
	import { day, ordinal, pct, plural, signedPct, tone } from "../lib/format";
	import { api, botUrl, link, localVisitor } from "../lib/site";
	import { summaryCard } from "../lib/summary";
	import { PERIODS, digits, type Board, type Me, type Period } from "../lib/types";
	import { lang } from "../i18n";
	import { board as words } from "../i18n/board";
	import { common } from "../i18n/common";

	localVisitor();
	const t = words[lang()];
	const c = common[lang()];
	const root = document.getElementById("board")!;
	let board: Board | null = null;
	let period = (new URLSearchParams(location.search).get("p") as Period) || "1m";
	if (!PERIODS.some((p) => p.key === period)) period = "1m";
	let signin: string | null = null;
	let scrolled = false;
	document.getElementById("to-weekly")!.prepend(trophy(13));
	let summary: HTMLElement | null = null; // the player's summary since their last visit

	const grid = "grid grid-cols-[1.8rem_minmax(0,1fr)_5.2rem] md:grid-cols-[2rem_minmax(0,1.5fr)_88px_5.6rem_5.6rem_6rem_minmax(0,1fr)] items-center gap-x-4 px-3 py-2.5";

	function line(e: Entry): HTMLElement {
		const b = board!;
		if (e.kind === "index") {
			return add(h("div", `${grid} bg-white/[0.015]`), h("span", "num text-[12px] text-faint", "—"),
				add(h("span", "flex min-w-0 items-center gap-3"), indexFace(30), add(h("span", "min-w-0"), h("span", "text-muted", "S&P 500"), h("span", "tag ml-2", b.benchmark.ticker))),
				h("span", "hidden md:block"), h("span", `num text-right font-semibold opacity-80 ${tone(e.value)}`, signedPct(e.value, digits(period))),
				h("span", "hidden md:block"), h("span", "hidden md:block"), h("span", "hidden md:block"));
		}
		const r = e.line;
		const rank = r.ranks[period];
		const a = h("a", `${grid} hover:bg-raised ${r.you ? "bg-signal-soft shadow-[inset_2px_0_0_var(--color-signal)]" : ""}`);
		a.href = botUrl(r.slug);
		add(a, h("span", `num text-[13px] ${rank && rank <= 3 ? "text-ink-strong" : "text-muted"}`, rank ? String(rank) : ""),
			add(h("span", "flex min-w-0 items-center gap-3"), robot(r.slug, 30), add(h("span", "min-w-0"),
				add(h("span", "flex min-w-0 items-center gap-2"), h("span", "truncate font-semibold text-ink-strong", r.name),
					winsTag(r.wins), r.you ? h("span", "tag tag-you shrink-0", c.you) : null),
				h("span", "block truncate text-[12px] text-muted", c.by(r.handle)))),
			add(h("span", "hidden justify-end md:flex"), sparkline(r.spark, 88, 26)),
			h("span", `num text-right font-semibold ${tone(e.value)}`, e.value == null ? (r.since ? "—" : c.nextClose) : signedPct(e.value, digits(period))),
			h("span", `num hidden text-right md:block ${tone(r.returns.all)}`, signedPct(r.returns.all, 1)),
			h("span", "hidden text-right text-[12.5px] text-muted md:block", r.since ? plural(r.sessions, ...c.session) : t.startsNext),
			h("span", "hidden truncate text-[12.5px] text-muted md:block", r.holdings.slice(0, 3).map((x) => `${x.ticker} ${pct(x.weight, 0)}`).join(" · ") + (r.cash && r.cash > 0.5 ? ` · ${c.cash} ${pct(r.cash, 0)}` : "")));
		return a;
	}

	// The first three of the period, on a podium: the first in the middle, raised.
	function podium(entries: Entry[]): HTMLElement | null {
		const top = entries.filter((e): e is Extract<Entry, { kind: "bot" }> => e.kind === "bot" && !!e.line.ranks[period] && e.line.ranks[period]! <= 3)
			.sort((x, y) => x.line.ranks[period]! - y.line.ranks[period]!);
		if (top.length < 3) return null;
		const place = (e: Extract<Entry, { kind: "bot" }>) => {
			const r = e.line, n = r.ranks[period]!;
			const a = add(h("a", `podium-place is-${n}`), robot(r.slug, n === 1 ? 64 : 52),
				h("span", "podium-name", r.name), h("span", "podium-by", c.by(r.handle)),
				h("span", `num podium-value ${tone(e.value)}`, signedPct(e.value, digits(period))),
				h("span", "podium-step num", String(n)));
			a.href = botUrl(r.slug);
			return a;
		};
		return add(h("div", "podium"), place(top[1]), place(top[0]), place(top[2]));
	}

	// The reader's own place, when they play: their bot, its place and its return over the period.
	function place(b: Board): HTMLElement | null {
		const r = b.rows.find((x) => x.you);
		if (!r || !b.visible) return null;
		const rank = r.ranks[period];
		const of = b.rows.filter((x) => x.ranks[period]).length;
		const v = r.returns[period];
		const a = add(h("a", "frame mb-6 flex items-center gap-4 px-4 py-3.5 hover:border-muted sm:px-5"),
			robot(r.slug, 44),
			add(h("div", "min-w-0 flex-1"),
				h("p", "label", `${t.yourPlace} · ${r.name}`),
				add(h("p", "mt-0.5 flex flex-wrap items-baseline gap-x-2"),
					h("span", "num text-[22px] font-semibold text-ink-strong", rank ? t.placeOf(ordinal(rank), of) : t.notPlaced),
					h("span", "text-[13px] text-muted", t.over[period]),
					v == null ? null : h("span", `num text-[13px] font-semibold ${tone(v)}`, signedPct(v, digits(period))))),
			h("span", "hidden text-[13px] text-muted sm:inline", t.toYourBot));
		a.href = link("/me/");
		return a;
	}

	function draw() {
		if (!board) return;
		const b = board;
		document.getElementById("asof")!.textContent = b.as_of ? t.toClose(day(b.as_of)) : t.starting;
		document.getElementById("tabs")!.replaceChildren(periodTabs(period, PERIODS, (p) => {
			period = p;
			history.replaceState(null, "", `?p=${p}`);
			draw();
		}));
		document.getElementById("count")!.textContent = plural(b.entrants, ...c.bot);
		const head = add(h("div", `${grid} !py-2 text-[12px] text-muted`), h("span", "", "#"), h("span", "", t.bot), h("span", "hidden md:block"),
			h("span", "text-right", PERIODS.find((p) => p.key === period)!.label), h("span", "hidden text-right md:block", t.sinceStart), h("span", "hidden text-right md:block", t.running),
			h("span", "hidden md:block", t.largest));
		const list = add(h("div", "divide-y divide-line"), head);
		if (!b.visible) list.append(add(h("div", "border-y border-signal-line"), locked(b, signin)));
		for (const e of ordered(b, period)) list.append(line(e));
		if (b.sample) list.append(h("p", "px-3 py-3 text-[12px] text-warn", c.sample));
		const mine = b.rows.some((r) => r.you);
		// A reader with a bot on the board is no first visit: no welcome, now or later.
		if (mine) {
			document.getElementById("welcome")?.setAttribute("hidden", "");
			try { localStorage.setItem("bl.welcome", "seen"); } catch {}
		}
		const join = mine ? null : add(h("div", "frame mt-8 flex flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-6"),
			add(h("div", "min-w-0"), h("p", "text-[16px] font-medium text-ink-strong", t.joinTitle),
				h("p", "mt-1 text-[13.5px] text-muted", t.joinBody)),
			Object.assign(h("a", "btn btn-signal", t.build), { href: link("/me/") }));
		root.replaceChildren(...[summary, b.visible ? podium(ordered(b, period)) : null, place(b), list, join].filter((x): x is HTMLElement => !!x));
		const prizes = b.visible && b.rows.length > 0;
		document.getElementById("to-weekly")!.hidden = !prizes;
		document.getElementById("weekly")!.replaceChildren(...(prizes ? [weeklySection(b.weekly)] : []));
		if (prizes && location.hash === "#weekly" && !scrolled) (scrolled = true), document.getElementById("weekly")!.scrollIntoView();
	}

	async function load() {
		board = await api<Board>("/api/board");
		draw();
		if (board.stale) {
			document.getElementById("asof")!.textContent = t.moving;
			await api("/api/board/refresh", { method: "POST" }).catch(() => null);
			board = await api<Board>("/api/board");
			draw();
		}
		// Once the bots are at the last close: how the player's own did since their last visit.
		const mine = board.rows.find((r) => r.you);
		if (mine) {
			summary = await summaryCard(mine.slug, board.as_of);
			draw();
		}
	}
	document.addEventListener("me", (e) => {
		const me = (e as CustomEvent<Me>).detail;
		signin = me.user ? null : me.signin;
		draw();
	});
	load().catch(() => root.replaceChildren(h("p", "py-10 text-center text-[14px] text-muted", t.unread)));
</script>
