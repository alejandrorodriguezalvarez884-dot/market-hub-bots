---
// The rules of the game, and the format of a bot folded away for the curious. The figures a bot
// can use come from the service (/api/bot/spec), so this page and the checks agree.
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n";
import { rules as words } from "../i18n/rules";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = words[lang];
---

<Layout title={t.title} description={t.description} page="rules" lang={lang}>
	<section class="wrap pt-10">
		<p class="kicker">{t.kicker}</p>
		<h1 class="h2 mt-3 max-w-2xl">{t.h1}</h1>
		<div class="mt-12 grid gap-x-12 gap-y-8 md:grid-cols-2">
			{t.rules.map(([title, body]) => (
				<div class="border-t border-line-strong pt-4">
					<h2 class="text-[16px] font-semibold text-ink-strong">{title}</h2>
					<p class="mt-1.5 text-[14px] text-muted">{body}</p>
				</div>
			))}
		</div>
	</section>

	<details class="wrap group/fmt pt-20">
		<summary class="cursor-pointer list-none">
			<p class="kicker">{t.formatKicker}</p>
			<h2 class="h2 mt-3">{t.formatTitle}</h2>
			<p class="mt-3 text-[14px] text-muted hover:text-ink-strong group-open/fmt:hidden">{t.formatOpen}</p>
		</summary>
		<div class="mt-8 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
			<div class="space-y-5 text-[14px] text-muted">
				{t.format.map((p) => <p set:html={p} />)}
			</div>
			<div class="frame overflow-hidden">
				<div class="frame-head"><span class="text-[13px] font-semibold text-ink-strong">{t.seven}</span><span class="text-[12px] text-muted">{t.fromCloses}</span></div>
				<div id="factors" class="divide-y divide-line"><div class="space-y-2 p-4"><div class="skeleton h-8"></div><div class="skeleton h-8"></div><div class="skeleton h-8"></div></div></div>
			</div>
		</div>
	</details>
</Layout>

<script>
	import { add, h } from "../lib/dom";
	import { api, localVisitor } from "../lib/site";
	import type { Spec } from "../lib/types";
	import { lang } from "../i18n";
	import { rules } from "../i18n/rules";

	localVisitor();
	const t = rules[lang()];
	const box = document.getElementById("factors")!;
	api<Spec>("/api/bot/spec")
		.then((s) => {
			box.replaceChildren(...Object.entries(s.factors).map(([name, f]) => add(h("div", "px-4 py-3"),
				add(h("div", "flex flex-wrap items-baseline gap-x-3"), h("span", "num text-[13px] font-medium text-signal-strong", name),
					h("span", "num text-[12px] text-muted", Object.entries(f.settings).map(([k, v]) => `${k} ${v.min}–${v.max}${v.default !== undefined ? ` ${t.byDefault(v.default)}` : ""}`).join(" · "))),
				h("p", "mt-1 text-[13px] text-ink", f.means.replace(/`/g, "")))));
		})
		.catch(() => box.replaceChildren(h("p", "p-4 text-[13px] text-muted", t.unread)));
</script>
