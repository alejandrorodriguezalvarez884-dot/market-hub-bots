---
// The member's own page. With no bot yet: how to create one, nothing else. With a bot: the bot
// drawn, at a glance (what it holds, how it is doing, what it has done), the tools to change it
// behind one button, and building again from scratch in a small corner at the foot.
// Signed in with the Market Hub account.
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n";
import { me as words } from "../i18n/me";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = words[lang];
---

<Layout title={t.title} description={t.description} page="me" noindex lang={lang}>
	<section class="wrap pt-10" id="me">
		<div class="flex items-center gap-5"><div class="skeleton h-24 w-24"></div><div class="flex-1"><div class="skeleton h-9 w-72 max-w-full"></div><div class="skeleton mt-3 h-5 w-48"></div></div></div>
		<div class="skeleton mt-10 h-72"></div>
	</section>
</Layout>

<script>
	import { chartWaiting, lineChart, type Series } from "../lib/chart";
	import { add, h } from "../lib/dom";
	import { day, plural, signedPct, tone } from "../lib/format";
	import { rankMeter, treemap } from "../lib/mybot";
	import { portfolioHistory } from "../lib/history";
	import { history as historyWords } from "../i18n/history";
	import { robot, robotSvg } from "../lib/robot";
	import { ApiError, api, botUrl, localVisitor } from "../lib/site";
	import { PERIODS, digits, type BotPage, type ChatStatus, type Me, type MyBot, type Overview, type Spec } from "../lib/types";
	import { said } from "../lib/doings";
	import { changePanel } from "../lib/change";
	import { builder } from "../lib/build";
	import { lang } from "../i18n";
	import { me as words } from "../i18n/me";
	import { companies as companyWords } from "../i18n/companies";
	import { share } from "../lib/words";
	import { summaryCard } from "../lib/summary";

	const t = words[lang()];
	const th = historyWords[lang()];
	const cw = companyWords[lang()];
	localVisitor();
	const root = document.getElementById("me")!;
	let data: Overview;
	let page: BotPage | null = null; // the bot's public page, read for its curve against the index and its start
	let rebuilding = false; // building a new bot, in place of the one there is
	let summary: HTMLElement | null = null; // the player's summary since their last visit

	const button = (cls: string, text: string, onClick: (b: HTMLButtonElement) => void) => {
		const b = h("button", cls, text);
		b.type = "button";
		b.addEventListener("click", () => onClick(b));
		return b;
	};
	const anchor = (cls: string, text: string, href: string) => Object.assign(h("a", cls, text), { href });
	const slugOf = (handle: string) => handle.replace(/[\s_-]+/g, "").toLowerCase();
	const section = (title: string, note?: Node | string | null) =>
		add(h("section", "sec mt-10"), add(h("div", "sec-head"), h("h2", "sec-title", title), note ? add(h("span", "sec-note"), note) : null));

	// --- Signed out ---

	function signedOut(signin: string | null) {
		root.replaceChildren(add(h("div", "frame relative mx-auto mt-6 max-w-xl overflow-hidden px-6 py-12 text-center sm:px-10"),
			h("p", "kicker relative", t.yourBot),
			h("h1", "h2 relative mt-3", t.signInTitle),
			h("p", "relative mx-auto mt-4 max-w-md text-[15px] text-muted", t.signInBody),
			signin ? anchor("btn btn-signal btn-big relative mt-8", t.signIn, signin) : h("p", "relative mt-6 text-[13px] text-muted", t.noSignIn)));
	}

	// --- No bot yet: create one ---

	// No bot yet (or building a new one): talk it through with Claude, right here.
	function create(me: Me) {
		const first = data.you?.handle ?? me.user?.name?.split(" ")[0] ?? t.there;
		const replacing = rebuilding ? data.you : null;
		const blueprint = h("span", "robot opacity-40");
		blueprint.innerHTML = robotSvg(slugOf(me.user?.name ?? "you"), 88);
		const build = spec ? builder({
			name: first, seed: slugOf(me.user?.name ?? "you"), spec, chat, replacing,
			sent: async () => {
				rebuilding = false;
				await reload();
				window.scrollTo({ top: 0, behavior: "smooth" });
			},
			cancel: replacing ? () => ((rebuilding = false), draw(me)) : undefined,
		}) : null;
		root.replaceChildren(
			add(h("div", "flex items-center gap-5"), blueprint, add(h("div", "min-w-0"),
				h("p", "kicker", replacing ? t.aNewBot : me.user?.name ? t.hello(first) : t.yourBot),
				h("h1", "h2 mt-1", replacing ? t.buildNew : t.createYours),
				h("p", "mt-2 max-w-xl text-[14px] text-muted", replacing
					? t.replacing(replacing.name)
					: t.createNote))),
			add(h("div", "mt-8"), build));
	}

	// --- A bot: drawn ---

	function statusOf(you: MyBot): HTMLElement {
		if (!you.since) return h("span", "status is-waiting", t.startsAt(page?.starts ? day(page.starts) : null));
		if (you.paused) return h("span", "status is-paused", t.paused);
		return h("span", "status", t.running(plural(you.sessions, t.session, t.sessions), day(you.since)));
	}

	// Renaming it: at once, keeping its record, and not the day's change of rules.
	let renaming = false;

	function title(you: MyBot): HTMLElement {
		if (!renaming) {
			return add(h("div"),
				add(h("div", "mt-1 flex flex-wrap items-baseline gap-x-3"), h("h1", "h2", you.name),
					button("text-[13px] text-muted hover:text-ink-strong", t.rename, () => {
						renaming = true;
						draw(lastMe!);
					})),
				you.about ? h("p", "mt-1 max-w-2xl text-[14px] text-muted", you.about) : null);
		}
		const name = h("input", "field max-w-md");
		name.value = you.name;
		name.maxLength = 40;
		const about = h("textarea", "field mt-2 min-h-[56px] max-w-2xl");
		about.value = you.about;
		about.maxLength = 280;
		const note = h("p", "mt-1 text-[12.5px] text-muted", t.renameNote);
		const save = button("btn btn-primary py-1.5 text-[13px]", t.save, async (el) => {
			el.disabled = true;
			try {
				await api("/api/bots/mine/name", { method: "PUT", body: { name: name.value, about: about.value } });
				renaming = false;
				await reload();
			} catch (e) {
				note.textContent = e instanceof Error ? e.message : t.failed;
				note.className = "mt-1 text-[12.5px] text-warn";
				el.disabled = false;
			}
		});
		const cancel = button("btn btn-ghost py-1.5 text-[13px]", t.cancel, () => {
			renaming = false;
			draw(lastMe!);
		});
		return add(h("div", "mt-1 w-full"), add(h("label", "block"), h("span", "label block pb-1", t.name), name),
			add(h("label", "block"), h("span", "label mt-2 block pb-1", t.idea), about), note, add(h("div", "mt-2 flex gap-2"), save, cancel));
	}

	function head(you: MyBot): HTMLElement {
		const slug = you.id ?? "";
		const pending = you.pending ? button("status is-waiting hover:border-muted", t.nextClose(said(you.pending.what) || t.aChange), () => toggleChange(true)) : null;
		return add(h("div", "flex flex-wrap items-center gap-x-6 gap-y-4"),
			robot(slug, 104, "robot-big"),
			add(h("div", "min-w-0 flex-1"),
				h("p", "kicker", t.byline(you.handle)),
				title(you),
				add(h("div", "mt-3 flex flex-wrap items-center gap-2"), statusOf(you), pending)),
			add(h("div", "flex w-full flex-wrap items-center gap-3 sm:w-auto"),
				button("btn btn-signal", changeOpen ? t.close : t.changeIt, () => toggleChange(!changeOpen)),
				anchor("text-[13px] text-muted hover:text-ink-strong", t.publicPage, botUrl(slug))));
	}

	function numbers(you: MyBot): HTMLElement {
		return add(h("div", "mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-5"),
			...PERIODS.map((p) => {
				const v = you.returns?.[p.key] ?? null;
				return add(h("div", `min-w-0 bg-page p-4 ${p.key === "all" ? "col-span-2 sm:col-span-1" : ""}`), h("div", "label", p.label),
					h("div", `num mt-1 text-[22px] font-semibold ${tone(v)}`, v == null ? "—" : signedPct(v, digits(p.key))),
					v == null ? h("div", "mt-2 text-[12px] text-faint", t.notYet) : rankMeter(you.ranks[p.key], you.entrants));
			}));
	}

	function curve(you: MyBot): HTMLElement {
		const chart = h("div");
		const sec = add(section(t.howDoing, page?.curve.length ? t.againstIndex : null), chart);
		requestAnimationFrame(() => {
			if (page && page.curve.length) {
				const series: Series[] = [
					{ name: "S&P 500", values: page.curve.map((p) => p.index), color: "var(--color-muted)", width: 1.5 },
					{ name: you.name, values: page.curve.map((p) => p.bot), color: "var(--color-signal)", width: 2.25 },
				];
				lineChart(chart, page.curve.map((p) => p.date), series, 260);
			} else if (you.curve.length > 1) {
				lineChart(chart, you.curve.map((p) => p.date), [{ name: you.name, values: you.curve.map((p) => p.value), color: "var(--color-signal)" }], 260);
			} else chartWaiting(chart, you.since ? t.lineFromSecond : t.lineStarts(page?.starts ? day(page.starts) : null), 160);
		});
		return sec;
	}

	function holds(you: MyBot): HTMLElement {
		if (!you.since && you.preview) {
			return add(section(t.wouldHold, add(h("span", "flex items-center gap-2"), h("span", "tag", t.preview), t.atCloseOf(day(you.preview.as_of)))),
				treemap(you.preview.weights, null, { preview: true }));
		}
		const weights = Object.fromEntries(you.holdings.map((x) => [x.ticker, x.weight]));
		return add(section(t.holds, you.as_of ? t.afterClose(day(you.as_of)) : null), treemap(weights, you.cash));
	}

	// What it has held and done, close by close: a date at a time, and every move (lib/history.ts).
	function portfolio(you: MyBot): HTMLElement {
		const weights = Object.fromEntries(you.holdings.map((x) => [x.ticker, x.weight]));
		const out = add(section(th.title, th.note),
			portfolioHistory({ log: you.log, versions: you.versions, now: { weights, cash: you.cash, as_of: you.as_of } }));
		if (you.always?.length) out.append(add(h("div", "mt-4 flex flex-wrap items-center gap-1.5"), h("span", "mr-1 text-[12.5px] text-muted", t.always),
			...you.always.map((p) => h("span", "chip num", p.min_weight > 0 ? `${p.ticker} · ${cw.least(share(p.min_weight))}` : p.ticker))));
		if (you.exclude.length) out.append(add(h("div", "mt-2 flex flex-wrap items-center gap-1.5"), h("span", "mr-1 text-[12.5px] text-muted", t.leftOut),
			...you.exclude.map((x) => h("span", "chip num", x))));
		return out;
	}

	function rules(you: MyBot): HTMLElement {
		return add(h("details", "corner mt-10"), h("summary", "", t.rulesInWords),
			add(h("ul", "mt-3 max-w-3xl space-y-1.5 text-[13.5px] text-ink"), ...you.rules.map((r) => add(h("li", "flex gap-2"), h("span", "text-muted", "›"), h("span", "", r)))));
	}

	// Building again from scratch, or withdrawing, folded away.
	function corner(): HTMLElement {
		return add(h("details", "corner mt-4 border-t border-line pt-4"), h("summary", "", t.startAgain),
			add(h("div", "mt-4 max-w-xl"), h("p", "text-[12.5px] text-muted", t.replaceNote),
				add(h("div", "mt-2 flex flex-wrap gap-2"),
					button("btn btn-ghost py-1.5 text-[13px]", t.buildWithClaude, () => {
						rebuilding = true;
						changeOpen = false;
						draw(lastMe!);
						window.scrollTo({ top: 0, behavior: "smooth" });
					}),
					button("btn btn-ghost py-1.5 text-[13px]", t.withdraw, async (el) => {
						if (!confirm(t.withdrawConfirm)) return;
						el.disabled = true;
						await api("/api/bots/mine", { method: "DELETE" });
						await reload();
					}))));
	}

	// --- Changing it: the chat and the switches first, every rule by hand behind them (lib/change.ts) ---

	let spec: Spec | null = null;
	let chat: ChatStatus = { on: false, per_member_per_day: 0 };
	let changeOpen = false;
	let changeBox: HTMLElement | null = null;

	function toggleChange(open: boolean) {
		changeOpen = open;
		if (lastMe) draw(lastMe);
		if (open) changeBox?.scrollIntoView({ behavior: "smooth", block: "start" });
	}

	function change(you: MyBot): HTMLElement | null {
		if (!changeOpen || !spec) return (changeBox = null);
		changeBox = changePanel({ you, spec, chat, reload, close: () => toggleChange(false) });
		changeBox.classList.add("mt-8", "scroll-mt-20");
		return changeBox;
	}

	// --- The page ---

	let lastMe: Me | null = null;

	async function readPage(you: MyBot | null) {
		page = you?.id ? await api<BotPage>(`/api/board/bot/${encodeURIComponent(you.id)}`).catch(() => null) : null;
	}

	async function reload() {
		data = await api<Overview>("/api/bots");
		await readPage(data.you);
		if (!data.you) changeOpen = false;
		if (lastMe) draw(lastMe);
	}

	function draw(me: Me) {
		lastMe = me;
		const you = data.you;
		if (!you || rebuilding) return create(me);
		root.replaceChildren();
		// Before it starts: what it would hold first, beside where its line will be.
		const body = you.since ? [curve(you), portfolio(you)] : [add(h("div", "grid gap-x-10 lg:grid-cols-2"), holds(you), curve(you))];
		add(root, summary, head(you), change(you), you.since ? numbers(you) : null, ...body, rules(you), corner());
	}

	async function load() {
		const me = await api<Me>("/api/me");
		if (!me.user) return signedOut(me.signin);
		try {
			data = await api<Overview>("/api/bots");
		} catch (e) {
			if (e instanceof ApiError && e.status === 401) return signedOut(e.signin ?? me.signin);
			throw e;
		}
		[spec, chat] = await Promise.all([api<Spec>("/api/bot/spec"), api<ChatStatus>("/api/bots/chat").catch(() => chat), readPage(data.you)]);
		draw(me);
		if (data.stale) {
			await api("/api/bots/refresh", { method: "POST" }).catch(() => null);
			await reload();
		}
		// Once the bot is at the last close: how it did since the player's last visit.
		if (data.you?.id && data.you.since) {
			summary = await summaryCard(data.you.id, data.you.as_of);
			if (lastMe) draw(lastMe);
		}
	}
	load().catch((e) => root.replaceChildren(h("p", "py-16 text-center text-[15px] text-muted", e instanceof Error ? e.message : t.unread)));
</script>
