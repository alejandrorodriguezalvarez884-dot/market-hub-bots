---
// The landing. First, and alone on the first screen: that this is a game, and the way in, one big
// button to the chat on "Your bot" that builds a bot with Claude. Below it, lighter: the leaderboard
// live, how to play in three steps, the rules and a few questions. Its words are in i18n/home.ts.
import Layout from "../layouts/Layout.astro";
import { link } from "../lib/site";
import type { Lang } from "../i18n";
import { home } from "../i18n/home";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = home[lang];
const L = (path: string) => link(path, lang);
---

<Layout title={t.title} description={t.description} page="home" lang={lang}>
	<!-- The first screen: the game in a line and the one button, to the chat that builds the bot. -->
	<section class="hero">
		<div class="wrap flex flex-col items-center pb-14 pt-12 text-center sm:pb-20 sm:pt-20">
			<p class="kicker">{t.kicker}</p>
			<h1 class="display mx-auto mt-4 !max-w-none"><span class="block">{t.h1}</span> <em class="block">{t.h1Em}</em> <span class="block">{t.h1End}</span></h1>
			<p class="mx-auto mt-5 max-w-[34rem] text-[16px] leading-relaxed text-ink sm:text-[17px]">{t.lede}</p>
			<a class="btn btn-signal btn-hero mt-8" href={L("/me/")} data-cta>
				<span class="build-mark" aria-hidden="true">✳</span><span>{t.cta}</span>
			</a>
			<ul class="badges mt-5">{t.badges.map((b) => <li>{b}</li>)}</ul>
			<a class="mt-6 text-[13.5px] text-muted hover:text-ink-strong" href="#board">{t.seeBoard}</a>
		</div>
	</section>

	<!-- The leaderboard, live, lighter. -->
	<section id="board" class="wrap scroll-mt-20">
		<div class="mx-auto max-w-3xl">
			<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
				<h2 class="text-[17px] font-semibold text-ink-strong">{t.theBoard}</h2>
				<span class="text-[12.5px] text-muted">{t.boardNote}</span>
			</div>
			<div class="frame mt-3" id="hero-board">
				<div class="frame-head">
					<span class="live whitespace-nowrap" id="hero-asof">{t.loading}</span>
					<span class="ml-auto" id="hero-tabs"></span>
				</div>
				<div id="hero-rows">
					<div class="space-y-px p-3"><div class="skeleton h-9"></div><div class="skeleton h-9"></div><div class="skeleton h-9"></div><div class="skeleton h-9"></div><div class="skeleton h-9"></div></div>
				</div>
				<a class="block border-t border-line px-4 py-2.5 text-[12.5px] text-muted hover:text-ink-strong" href={L("/board/")}>{t.wholeBoard}</a>
			</div>
		</div>
	</section>

	<!-- How to play: three steps, with the conversation beside them. -->
	<section id="how" class="wrap scroll-mt-20 pt-24">
		<p class="kicker chapter">{t.howKicker}</p>
		<h2 class="h2 mt-3 max-w-2xl">{t.howTitle}</h2>
		<div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.15fr]">
			<ol class="space-y-8">
				{t.steps.map(([title, body], i) => (
					<li class="grid grid-cols-[2.5rem_1fr] gap-3">
						<span class="step-n">{i + 1}</span>
						<div>
							<h3 class="text-[17px] font-semibold text-ink-strong">{title}</h3>
							<p class="mt-1 text-[14px] text-muted">{body}</p>
						</div>
					</li>
				))}
			</ol>
			<div class="frame overflow-hidden" aria-label={t.mockLabel}>
				<div class="frame-head">
					<span class="build-mark build-mark-sm" aria-hidden="true">✳</span>
					<span class="text-[12.5px] font-medium text-ink-strong">{t.mockHead}</span>
					<span class="ml-auto text-[12px] text-faint">{t.yourBot}</span>
				</div>
				<div class="mock flex flex-col gap-2.5 p-4 sm:p-5" id="mock">
					<p class="line bubble is-me">{t.mock.me1}</p>
					<div class="line bubble is-them"><span class="bubble-who">{t.mock.claude}</span><span>{t.mock.them1}</span></div>
					<div class="line step-line"><span class="step-dot"></span><div><p class="step-text">{t.mock.draft1}</p><p class="step-note">{t.mock.draft1Note}</p></div></div>
					<p class="line bubble is-me">{t.mock.me2}</p>
					<div class="line step-line"><span class="step-dot"></span><div><p class="step-text">{t.mock.draft2}</p><p class="step-note">{t.mock.draft2Note}</p></div></div>
					<div class="line step-line is-test"><span class="step-dot"></span><div><p class="step-text">{t.mock.test}</p><p class="step-note">{t.mock.testNote}</p></div></div>
					<div class="line flex flex-wrap items-center gap-2 pt-1"><span class="btn btn-signal pointer-events-none py-1.5 text-[13px]">{t.mock.send}</span><span class="text-[12px] text-faint">{t.mock.starts}</span></div>
				</div>
			</div>
		</div>
	</section>

	<!-- The rules in six. -->
	<section class="wrap pt-28">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="kicker chapter">{t.rulesKicker}</p>
				<h2 class="h2 mt-3">{t.rulesTitle}</h2>
			</div>
			<a class="link text-[14px] text-signal" href={L("/rules/")}>{t.allRules}</a>
		</div>
		<div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
			{t.rules.map(([title, body]) => (
				<div class="border-t border-line-strong pt-4">
					<h3 class="text-[15px] font-semibold text-ink-strong">{title}</h3>
					<p class="mt-1 text-[14px] text-muted">{body}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Questions. -->
	<section class="wrap pt-28">
		<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
			<div>
				<p class="kicker chapter">{t.faqKicker}</p>
				<h2 class="h2 mt-3">{t.faqTitle}</h2>
			</div>
			<div class="divide-y divide-line border-y border-line">
				{t.faq.map(([q, a]) => (
					<details class="group py-4">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-ink-strong">
							{q}<span class="text-muted transition group-open:rotate-45">+</span>
						</summary>
						<p class="mt-2 max-w-prose text-[14px] text-muted">{a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- The way in, again. -->
	<section class="wrap pt-28">
		<div class="frame relative overflow-hidden px-6 py-12 text-center sm:px-12">
			<h2 class="h2 relative mx-auto max-w-xl">{t.endTitle}</h2>
			<p class="relative mx-auto mt-4 max-w-md text-[15px] text-muted">{t.endBody}</p>
			<a class="btn btn-signal btn-big relative mt-8" href={L("/me/")} data-cta>{t.cta}</a>
		</div>
	</section>
</Layout>

<script>
	import { locked, ordered, periodTabs, row } from "../lib/board";
	import { add, h } from "../lib/dom";
	import { day } from "../lib/format";
	import { api, localVisitor } from "../lib/site";
	import type { Board, Me, Period } from "../lib/types";
	import { lang } from "../i18n";
	import { home } from "../i18n/home";

	localVisitor();
	const t = home[lang()];
	const rows = document.getElementById("hero-rows")!;
	const asOf = document.getElementById("hero-asof")!;
	const tabs = document.getElementById("hero-tabs")!;
	let board: Board | null = null;
	let period: Period = "1m";
	let signin: string | null = null;
	const SHOWN = 5;

	function draw() {
		if (!board) return;
		const b = board;
		asOf.textContent = b.as_of ? t.closeOf(day(b.as_of)) : t.starting;
		const shown: { key: Period; label: string }[] = [
			{ key: "1d", label: t.tabs.day },
			{ key: "1w", label: t.tabs.week },
			{ key: "1m", label: t.tabs.month },
			{ key: "all", label: t.tabs.all },
		];
		tabs.replaceChildren(periodTabs(period, shown, (p) => ((period = p), draw())));
		const list = ordered(b, period).slice(0, SHOWN);
		const body = h("div");
		if (!b.visible) body.append(locked(b, signin));
		for (const e of list) body.append(row(e, period, b.benchmark.ticker));
		if (!list.length) body.append(h("p", "px-4 py-8 text-center text-[13px] text-muted", t.firstBots));
		if (b.sample) body.append(h("p", "border-t border-line px-4 py-2 text-[11.5px] text-warn", t.sample));
		rows.replaceChildren(body);
	}

	async function load() {
		board = await api<Board>("/api/board");
		draw();
		if (board.stale) {
			asOf.textContent = t.moving;
			await api("/api/board/refresh", { method: "POST" }).catch(() => null);
			board = await api<Board>("/api/board");
			draw();
		}
	}
	document.addEventListener("me", (e) => {
		const me = (e as CustomEvent<Me>).detail;
		signin = me.user ? null : me.signin;
		draw();
	});
	load().catch(() => {
		rows.replaceChildren(add(h("p", "px-4 py-8 text-center text-[13px] text-muted"), t.unread));
	});

	// The conversation writes itself out once it is on screen.
	const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const mock = document.getElementById("mock")!;
	const lines = [...mock.querySelectorAll<HTMLElement>(".line")];
	const seen = new IntersectionObserver((entries) => {
		if (!entries.some((x) => x.isIntersecting)) return;
		seen.disconnect();
		lines.forEach((l, i) => setTimeout(() => l.classList.add("on"), reduced ? 0 : i * 650));
	}, { threshold: 0.3 });
	seen.observe(mock);
</script>
