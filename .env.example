# Copy to .env and fill in. .env is ignored by git: never commit keys.
# Nothing here is a paid key: closes come from Yahoo Finance (the yfinance library) and the list
# of the largest companies from the SEC, which take none.

# Market Hub: its address, for signing in there. The hub's session secret comes from Secret
# Manager on deploy (market-hub-session-secret); locally set HUB_SESSION_SECRET too, or leave both
# empty and everyone is one local member.
HUB_URL=https://themarkethub.app

# The SEC asks for a contact in the User-Agent of whoever reads its list of companies.
SEC_USER_AGENT=

# The board is public (1, the default): visitors who are not signed in see the members' bots too,
# as Market Hub's privacy page says. 0 shows them to signed-in members only.
BOTLEAGUE_PUBLIC_BOARD=1

# The chat on a member's page spends on this Anthropic key. Off until the owner agrees the model and
# the caps (docs/HANDOFF.md); the key goes in Secret Manager on deploy, never here in the repo.
BOTLEAGUE_CHAT=1
BOTLEAGUE_CHAT_MODEL=claude-haiku-5-5
BOTLEAGUE_CHAT_EFFORT=high
BOTLEAGUE_CHAT_PER_MEMBER_PER_DAY=15
# Empty: no cap a day for the whole service (the owner's choice).
BOTLEAGUE_CHAT_DAILY_MAX_USD=
